# HTTP
PORT=5000
NODE_ENV=development

# PostgreSQL connection (local dev by default).
# For production use a hosted instance, e.g. GCP Cloud SQL or Neon:
# DATABASE_URL=postgres://user:password@host:5432/team_task_manager?sslmode=require
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/team_task_manager

# Session
SESSION_SECRET=change-me-to-a-long-random-string

# Frontend origin allowed to send credentials (cookies) back to this API
CLIENT_ORIGIN=http://localhost:5173
